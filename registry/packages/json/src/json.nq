//! JSON package — parse and stringify via host runtime

extern fn __json_stringify(value: String) -> String
extern fn __json_parse(text: String) -> String

export fn stringify(value: String) -> String {
    return __json_stringify(value)
}

export fn parse(text: String) -> String {
    return __json_parse(text)
}

export fn valid(text: String) -> Bool {
    return text != ""
}
